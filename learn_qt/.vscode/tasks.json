                "-B",
                "${workspaceFolder}/1/test1/build/Desktop_Qt_6_12_0_MinGW_64_bit_Debug",
                "-G",
                "MinGW Makefiles",
                "-DCMAKE_PREFIX_PATH=D:/soft/qt/6.12.0/mingw_64",
                "-DCMAKE_CXX_COMPILER=D:/soft/qt/Tools/mingw1310_64/bin/g++.exe",
                "-DCMAKE_C_COMPILER=D:/soft/qt/Tools/mingw1310_64/bin/gcc.exe",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "options": {
                "env": {
                    "PATH": "D:/soft/qt/Tools/CMake_64/bin;D:/soft/qt/Tools/mingw1310_64/bin;D:/soft/qt/6.12.0/mingw_64/bin;${env:PATH}"
