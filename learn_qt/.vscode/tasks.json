        },
        {
            "label": "Build and Run",
            "type": "shell",
            "command": "${workspaceFolder}/1/test1/build/Desktop_Qt_6_12_0_MinGW_64_bit_Debug/apptest1.exe",
            "options": {
                "env": {
                    "PATH": "D:/soft/qt/6.12.0/mingw_64/bin;D:/soft/qt/Tools/mingw1310_64/bin;D:/soft/qt/Tools/CMake_64/bin;${env:PATH}"
                }
